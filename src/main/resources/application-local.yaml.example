spring:
  datasource:
    url: jdbc:h2:mem:moyeota
    username: sa
    password:

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  h2:
    console:
      enabled: true

moyeota:
  auth:
    jwt:
      # 로컬 전용 값. 운영은 JWT_SECRET 환경변수로 주입한다. HS256이라 UTF-8 32바이트 이상 필요.
      secret: local-only-moyeota-access-token-secret-0123456789
    cookie:
      secure: false
